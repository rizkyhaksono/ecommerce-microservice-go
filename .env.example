# Root .env — read by `docker compose` for ${VAR} substitution in docker-compose.yml.
# Copy to .env and override the defaults baked into docker-compose.yml.
# (Per-service settings like ports/DB live in services/*/.env.example, not here.)

# Shared JWT secrets (user-service issues, all services validate)
JWT_ACCESS_SECRET_KEY=super-secret-access-key
JWT_REFRESH_SECRET_KEY=super-secret-refresh-key

# Initial admin user seeded by user-service on first start
START_USER_EMAIL=admin@example.com
START_USER_PW=admin123
