# ── Gateway (local dev) ──────────────────────────
# For running the binary on the host. In docker-compose these are set there instead.
SERVER_PORT=9090
GO_ENV=development

USER_SERVICE_URL=http://localhost:9091
CATALOG_SERVICE_URL=http://localhost:9092
ORDER_SERVICE_URL=http://localhost:9093

# ── OpenTelemetry (observability) ──
# Inside docker use http://otel-collector:4317; on the host use the published port below.
OTEL_SERVICE_NAME=gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.namespace=ecommerce
# OTEL_SERVICE_VERSION=1.0.0   # optional (default 1.0.0)
