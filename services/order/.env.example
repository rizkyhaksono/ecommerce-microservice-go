# ── Order Service (local dev) ──────────────────────────
# For running the binary on the host. In docker-compose these are set there instead.
SERVER_PORT=9093
GO_ENV=development

# DB_PORT = host-published port of order-db in docker-compose.yml (5502 -> container 5432)
DB_HOST=localhost
DB_PORT=5502
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=order_db
DB_SSLMODE=disable

# Order only validates access tokens, so it needs only the access secret.
JWT_ACCESS_SECRET_KEY=super-secret-access-key

# ── OpenTelemetry (observability) ──
# Inside docker use http://otel-collector:4317; on the host use the published port below.
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.namespace=ecommerce
# OTEL_SERVICE_VERSION=1.0.0   # optional (default 1.0.0)
